<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_intern_employee_form" model="ir.ui.view">
        <field name="name">intern.employee.form</field>
        <field name="model">intern.employee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="position"/>
                        <field name="base_salary"/>
                        <field name="bonus"/> 
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_intern_employee_tree" model="ir.ui.view">
        <field name="name">intern.employee.tree</field>
        <field name="model">intern.employee</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="position"/>
                <field name="base_salary"/>
                <field name="bonus"/>   
            </tree>
        </field>
    </record>

    <record id="action_intern_employee" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">intern.employee</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_intern_employee_root" 
        name="Employee Tracker" 
        sequence="10"/>

    <menuitem id="menu_intern_employee_list" 
        name="Employees" 
        parent="menu_intern_employee_root" 
        action="action_intern_employee" sequence="10"/>
</odoo>