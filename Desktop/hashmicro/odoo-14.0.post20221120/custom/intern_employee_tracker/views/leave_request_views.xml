<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leave_request_form" model="ir.ui.view">
        <field name="name">intern.leave.request.form</field>
        <field name="model">intern.leave.request</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="reason"/> 
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_leave_request_tree" model="ir.ui.view">
        <field name="name">intern.leave.request.tree</field>
        <field name="model">intern.leave.request</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="reason"/>    
            </tree>
        </field>
    </record>

    <record id="action_leave_request" model="ir.actions.act_window">
        <field name="name">Intern Leave Request</field>
        <field name="res_model">intern.leave.request</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_intern_leave_request" 
        name="Intern Leave Request" 
        parent="menu_intern_employee_root" 
        action="action_leave_request" sequence="20"/>
        
</odoo>